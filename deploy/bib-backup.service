# bib nightly logical backup (systemd --user). Pair with bib-backup.timer.
# Reads the application DSN from ~/.config/bib/env; writes pg_dump -Fc files
# to ~/backups/bib and keeps the newest 3.
[Unit]
Description=bib nightly PostgreSQL dump

[Service]
Type=oneshot
EnvironmentFile=%h/.config/bib/env
ExecStart=/bin/bash -c 'set -euo pipefail; d="$HOME/backups/bib"; mkdir -p "$d"; chmod 700 "$d"; dsn="${BIB_DATABASE_URL/postgresql+psycopg:/postgresql:}"; f="$d/bib-$(date -u +%%Y%%m%%dT%%H%%M%%SZ).dump"; pg_dump -Fc -Z 6 -d "$dsn" -f "$f.part" && mv "$f.part" "$f"; ls -1t "$d"/bib-*.dump | tail -n +4 | xargs -r rm -f; echo "wrote $f ($(du -h "$f" | cut -f1))"'
Nice=10
IOSchedulingClass=idle
