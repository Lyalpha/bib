# Copy to .env or ~/.config/bib/env. Never commit a filled copy.
# Sandbox defaults match compose.yaml; change them for any public host.

BIB_DATABASE_URL=postgresql+psycopg://bib:bib@localhost:5432/bib
# BIB_ADMIN_TOKEN=
# BIB_SENTRY_DSN=
# BIB_GOATCOUNTER_URL=https://YOURCODE.goatcounter.com/count
# BIB_ALLOWED_HOSTS=bib.example.org
# BIB_EXPOSE_DOCS=false
# BIB_SENTRY_ENVIRONMENT=production
